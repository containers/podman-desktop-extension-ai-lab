summary: | 
  This plan provisions a test environment for running Playwright E2E tests for the Podman Desktop AI Lab extension.
  It installs all required system dependencies, including GUI libraries, 
  sets up Node.js with pnpm, and starts Podman rootless service.

discover:
    how: fmf

execute:
    how: tmt 

provision: 
  hardware: 
    memory: ">= 16 GB"
    cpu: 
      cores: ">= 4"
    disk:
      - size: ">= 20 GB"

environment:
  EXT_TEST_GPU_SUPPORT_ENABLED: false

prepare:
  - name: Install required packages
    how: shell
    script: |
      sudo dnf update -y
      sudo dnf install -y \
      git curl xorg-x11-server-Xvfb \
        nss nspr atk at-spi2-atk at-spi2-core cups cups-libs dbus-libs cairo pango alsa-lib \
        libX11 libXcomposite libXdamage libXext libXfixes libXrandr libXtst libxcb libxkbcommon libxshmfence libdrm \
        mesa-libgbm mesa-libEGL mesa-dri-drivers \
        gcc-c++ gtk3 passt jq
      # Install Node.js directly from official binary (if not already installed)
      
      if ! command -v node &> /dev/null || [[ "$(node -v)" != "$NODE_VERSION" ]]; then
        curl -fsSL https://nodejs.org/dist/$NODE_VERSION/node-$NODE_VERSION-linux-x64.tar.xz -o node.tar.xz || exit 1
        sudo tar -C /usr/local --strip-components=1 -xf node.tar.xz || exit 1
        rm -f node.tar.xz
      fi
      
      npm install -g pnpm
      echo "NodeJS version: $(node -v)"
      echo "npm version: $(npm -v)"
      echo "pnpm Version: $(pnpm --version)"
  
  - name: Install podman  
    how: shell
    script: | 
      bash $TMT_TREE/tests/tmt/scripts/install-podman.sh

  - name: Enable and start Podman rootless service
    how: shell
    script: |
      systemctl --user enable podman.socket || exit 1
      systemctl --user start podman.socket || exit 1
      systemctl --user is-active podman.socket || exit 1

  - name: Pre-pull inference images
    how: shell
    script: |
      # The ~1.7GB inference images pull much slower on some Fedora composes. When the pull
      # happens *during* a test it holds the podman image-store lock long enough that
      # podman-desktop's image listing times out (30s), derailing playground/recipe creation.
      # Pre-pull them here (outside the test timeout) so the suite finds them ready.
      # ponytail: image list tracked from the extension's inference-images.json (CPU defaults).
      IMAGES_JSON="$TMT_TREE/packages/backend/src/assets/inference-images.json"
      jq -r '[.. | .default? // empty] | unique[]' "$IMAGES_JSON" | while read -r image; do
        echo "Pre-pulling ${image}"
        podman pull "${image}" || echo "Warning: failed to pre-pull ${image}"
      done

/e2e:
  summary: Execute Playwright E2E tests.
  discover+: 
    filter: 'tag:e2e'

/smoke: 
  summary: Execute smoke Playwright E2E tests.
  discover+: 
    filter: 'tag:smoke'

/instructlab: 
  summary: Execute instructlab Playwright E2E tests.
  discover+:
    filter: 'tag:instructlab'
