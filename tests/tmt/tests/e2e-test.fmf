summary: Execute Playwright E2E tests.
tag:
  - e2e
duration: 1h
result: custom
framework: shell
test: |
  set +e

  git clone https://github.com/podman-desktop/podman-desktop "$TMT_TREE/podman-desktop"
  export PODMAN_DESKTOP_ARGS="$TMT_TREE/podman-desktop"
  (
    cd "$PODMAN_DESKTOP_ARGS"
    pnpm install
    pnpm build
  )

  (
    cd "$TMT_TREE/tests/playwright"
    pnpm add -D @podman-desktop/tests-playwright@next
  )

  (
    cd "$TMT_TREE"
    pnpm install
    pnpm build
    pnpm test:e2e
  )
  
  EXIT_CODE=$?

  # --- TEMP DIAGNOSTICS (branch diag/fedora43-podman-env): why does podman image
  # listing hang on Fedora-43 but not Fedora-42? Dump env + podman state to output.txt. ---
  echo "===== PODMAN ENV DIAGNOSTICS ====="
  echo "--- uname ---"; uname -a
  echo "--- nproc/mem/disk ---"; nproc; free -h; df -h
  echo "--- podman version ---"; timeout 30 podman version || echo "(podman version timed out)"
  echo "--- podman info ---"; timeout 60 podman info || echo "(podman info timed out)"
  echo "--- system storage.conf ---"; cat /etc/containers/storage.conf 2>/dev/null || echo "(none)"
  echo "--- user storage.conf ---"; cat "$HOME/.config/containers/storage.conf" 2>/dev/null || echo "(none)"
  echo "--- podman images -a (60s cap) ---"; time timeout 60 podman images -a || echo "(podman images timed out/failed)"
  echo "--- podman system df ---"; timeout 60 podman system df || echo "(failed)"
  echo "--- podman ps -a ---"; timeout 60 podman ps -a || echo "(failed)"
  echo "--- podman API socket health (this is what podman-desktop uses) ---"
  SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
  echo "socket path: $SOCK (exists: $([ -S "$SOCK" ] && echo yes || echo no))"
  echo "--- systemctl --user podman.socket ---"; systemctl --user status podman.socket --no-pager 2>&1 | head -8 || echo "(none)"
  echo "--- systemctl --user podman.service ---"; systemctl --user status podman.service --no-pager 2>&1 | head -8 || echo "(none)"
  echo "--- API /libpod/info via socket (40s cap) ---"; time timeout 40 curl -s --unix-socket "$SOCK" "http://d/v5.0.0/libpod/info" -o /dev/null -w "http=%{http_code}\n" || echo "(API info timed out/failed)"
  echo "--- API /libpod/images/json via socket (40s cap) ---"; time timeout 40 curl -s --unix-socket "$SOCK" "http://d/v5.0.0/libpod/images/json" -o /dev/null -w "http=%{http_code}\n" || echo "(API images/json timed out/failed)"
  echo "--- model storage (did ibm-granite GGUF actually download?) ---"
  find "$TMT_TREE" -iname "*.gguf" -printf "%s bytes  %p\n" 2>/dev/null | head || echo "(no gguf found)"
  find "$TMT_TREE" -ipath "*models*" -type f -printf "%s bytes  %p\n" 2>/dev/null | head -20 || true
  # FULL journal, captured BEFORE the probe pull below, so it reflects only the test's own
  # podman activity during create-playground (look for POST images/create or containers/create).
  echo "--- FULL journalctl --user -u podman (whole run) ---"; journalctl --user -u podman --no-pager 2>/dev/null | tail -8000 || echo "(no user journal)"
  echo "--- direct CLI pull of inference image (300s cap, AFTER journal capture) ---"; time timeout 300 podman pull quay.io/ramalama/ramalama-llama-server@sha256:293f66f2dfea8e21393dc03e898616b2a71f0a72a0f3bc5f936439130ada2648 2>&1 | tail -6 || echo "(pull timed out/failed)"
  echo "===== END DIAGNOSTICS ====="

  bash "$TMT_TREE/tests/tmt/scripts/create-results.sh" "$EXIT_CODE" "e2e"
